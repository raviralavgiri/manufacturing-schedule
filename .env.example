# For LOCAL DEVELOPMENT ONLY.
#
# Copy to `.env.development.local` and fill in your values. Vite will only
# load this file for `npm run dev` (mode=development), NOT for production
# builds. This keeps your real key out of the deployed bundle even if you
# happen to build locally.
#
# Production builds use the obfuscated credentials in
# src/config/supabaseConfig.ts. To rotate those:
#   npm run obfuscate-credentials -- "<URL>" "<ANON_KEY>"
#
# Without these env vars set, the dev server falls back to the same
# obfuscated values as production.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your-public-anon-key
